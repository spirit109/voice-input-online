[Desktop Entry]
Version=1.0
Type=Application
Name=Azure Voice Input (Terminal)
Name[zh_CN]=Azure 语音输入（终端）
Comment=Recognize one utterance and insert it into the active terminal
Comment[zh_CN]=识别一次语音并输入到当前终端
Exec=@PROJECT_DIR@/voice-input-once.sh --mode terminal
Path=@PROJECT_DIR@
Terminal=false
Icon=audio-input-microphone
Categories=Utility;
StartupNotify=false
